<Window x:Class="Nootbook.EditElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nootbook"
        mc:Ignorable="d"
        Title="EditElementWindow" Height="200" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="LightGray">
            <TextBlock Text="Edit Educational Element"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <Canvas>
            <Canvas.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Canvas.Resources>

            <Label Content="Name :"
                   Canvas.Left="15"
                   Canvas.Top="20"
                   FontSize="13"/>

            <TextBox x:Name="name"
                     Width="155"
                     Height="23"
                     Canvas.Left="95"
                     Canvas.Top="27"/>

            <Label Content="Coefficient :"
                   Canvas.Left="15"
                   Canvas.Top="60"
                   FontSize="13"/>

            <TextBox x:Name="coef"
                     Width="75"
                     Height="23"
                     Canvas.Left="175"
                     Canvas.Top="67"/>

            <Button Content="Validate"
                    Canvas.Left="100"
                    Canvas.Top="120"
                    Width="75"
                    Height="25"
                    Click="Validate"/>
        </Canvas>
    </Grid>
</Window>
