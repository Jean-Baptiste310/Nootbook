<Window x:Class="Nootbook.ListExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nootbook"
        mc:Ignorable="d"
        Title="ListExamsWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="LightGray">
            <TextBlock Text="List of exam" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock Text="×" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="24" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="CloseWindow"/>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="#333333"
                BorderThickness="1.5"
                Margin="12,5,12,0">

       <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

             
                <Grid Grid.Row="0" Background="LightGray">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#333333"
                            BorderThickness="0,0,1,1">
                        <TextBlock Text="Date"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="1"
                            BorderBrush="#333333"
                            BorderThickness="0,0,1,1">
                        <TextBlock Text="Module"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="#333333"
                            BorderThickness="0,0,1,1">
                        <TextBlock Text="Teacher"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Column="3"
                            BorderBrush="#333333"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="Score"
                                   Margin="8,0"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>


                <ListBox Grid.Row="1"
                         x:Name="exams"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="0"
                         ItemsSource="{Binding Exams}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        BorderBrush="#333333"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="{Binding DateExam}"
                                               Margin="8,0"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1"
                                        BorderBrush="#333333"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="{Binding Module.Name}"
                                               Margin="8,0"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="2"
                                        BorderBrush="#333333"
                                        BorderThickness="0,0,1,0">
                                    <TextBlock Text="{Binding Teacher}"
                                               Margin="8,0"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Score}"
                                           Margin="8,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        
        <Button Grid.Row="2"
                Content="Close"
                Width="95"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="CloseWindow"/>
    
    </Grid>
</Window>
