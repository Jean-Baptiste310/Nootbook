<Window x:Class="Nootbook.Examen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nootbook"
        mc:Ignorable="d"
        Title="Examen" Height="350" Width="800">
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="LightGray">
            <TextBlock Text="Create an exam" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Canvas>
            <Canvas.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                 CornerRadius="10"
                 Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Canvas.Resources>

            
            <Label Content="Module : " Canvas.Left="60" Canvas.Top="45" FontSize="15"/>
            <ComboBox x:Name="modules"  Canvas.Left="150" Canvas.Top="50" Width="140"/>

            <Label Content="Date : " Canvas.Left="450" Canvas.Top="45" FontSize="15"/>
            <DatePicker x:Name="date"  Canvas.Left="530" Canvas.Top="50" Width="140"/>

            <Label Content="Absent " Canvas.Left="100" Canvas.Top="100" FontSize="15"/>
            <CheckBox x:Name="isAbsent"  Canvas.Left="70" Canvas.Top="108"/>

            <Label Content="Teacher : " Canvas.Left="450" Canvas.Top="100" FontSize="15"/>
            <TextBox  x:Name="teacher" Canvas.Left="530" Canvas.Top="107" Width="140"/>

            <Label Content="Score : " Canvas.Left="60" Canvas.Top="150" FontSize="15"/>
            <TextBox x:Name="score" Canvas.Left="150" Canvas.Top="155" Width="140"/>

            <Label Content="Coef : " Canvas.Left="450" Canvas.Top="150" FontSize="15"/>
            <TextBox x:Name="coef" Canvas.Left="530" Canvas.Top="157" Width="140"/>


            <Button Content="Validate" Canvas.Left="300" Canvas.Top="220" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65" Click="Validate"/>
            <Button Content="Cancel" Canvas.Left="400" Canvas.Top="220" Width="65" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Cancel"/>

        </Canvas>
    </Grid>
</Window>
