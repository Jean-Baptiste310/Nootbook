<Window x:Class="Nootbook.EditUnitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nootbook"
        mc:Ignorable="d"
        Title="EditUnitsWindow" Height="350" Width="300">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="LightGray">
            <TextBlock Text="Edit Units" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Canvas>
            <Canvas.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="LightGray"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                         CornerRadius="10"
                         Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Canvas.Resources>

            <Label Content="Course untis :" Canvas.Left="50" Canvas.Top="70" FontSize="15"/>


            <ListBox x:Name="unit"  Width="170" Height="112" Canvas.Left="50" Canvas.Top="100" MouseDoubleClick="listunit"/>

            <Button Content="Add" Canvas.Left="60" Canvas.Top="220" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65" Click="Addunit"/>
            <Button Content="Remove" Canvas.Left="140" Canvas.Top="220" Width="65"/>
        </Canvas>
    </Grid>
</Window>
